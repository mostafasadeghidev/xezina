{
  "name": "xezina",
  "description": "Sync, organize and search your bookmarks across every browser — with the storage of your choice.",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "local": "wxt build && node scripts/install-local.mjs"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "aws4fetch": "^1.0.20",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "fractional-indexing": "^3.4.0",
    "lucide-react": "^1.59.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.6",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "webdav-server": "^2.6.3",
    "wxt": "^0.20.27"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  }
}
